{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dj-mb",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dj-mb",
      "database_id": "ce4cffe2-efc7-46df-abb2-4d3afffec014",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DJ_NAME": "DJ MB"
  },
  "observability": { "enabled": true }
}
